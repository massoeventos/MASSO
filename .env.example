APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack

ROUTE_SYSTEM=sistema.massoeventos.test
ROUTE_WEB=massoeventos.test

DB_CONNECTION=mysql
DB_PORT=3306
DB_HOST=host.docker.internal
DB_DATABASE=massoeventos
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_DRIVER=sync
SESSION_DRIVER=file
SESSION_LIFETIME=1440
SESSION_SECURE_COOKIE=true

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mail@masso.test
MAIL_PASSWORD=THE_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS='no-responder@masso.test'
MAIL_FROM_NAME='Plataforma Masso Eventos'

DEV_TESTING_MAIL='dev@gmail.com'

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
